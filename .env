# Local only (2026-09-22). The backend on this machine: `./gradlew bootRun` in the server repository serves it
# on 8080. The project left the incumbent developer's Vercel and Render, and his Google Maps key left with them.
# For address suggestions, put a browser key of your own in .env.local (git-ignored) as VITE_GOOGLE_API_KEY.
# Without one the address fields offer no suggestions and still take a typed address.
VITE_API_BASE_URL=http://localhost:8080
