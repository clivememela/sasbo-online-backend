# Production Backend Environment Variables
# Used for: Production Render service (live)
# Service: sasbo-online-backend-prod
# Database: PostgreSQL production instance (protected)

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://prod-db-host:5432/sasbo_production
SPRING_DATASOURCE_USERNAME=sasbo_prod_user
SPRING_DATASOURCE_PASSWORD=production_password_very_secure_123

# Spring Configuration
SPRING_PROFILES_ACTIVE=production
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false

# Server Configuration
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/

# Logging Configuration
LOGGING_LEVEL_ROOT=WARN
LOGGING_LEVEL_ZA_CO_TITANDYNAMIX=INFO
LOGGING_PATTERN_CONSOLE=%d{yyyy-MM-dd HH:mm:ss} - %msg%n

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://sasbo.online,https://www.sasbo.online

# JPA/Hibernate Configuration
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=false

# Connection Pool Configuration
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=30
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=15
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=20000
SPRING_DATASOURCE_HIKARI_IDLE_TIMEOUT=300000

# Flyway Configuration
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false
