# The absolute origin of the backend, baked into the bundle at BUILD time by Vite.
#
#   Local (what the tracked `.env` carries):  http://localhost:8080
#       `./gradlew bootRun` in the server repository serves it there, and `npm run dev` puts this client on
#       http://localhost:5173 — the one origin the backend's CORS policy admits.
#
#   Behind a same-origin proxy — LEAVE IT EMPTY:
#       `apiUrl()` then emits relative `/api/...` paths, which the proxy forwards. That is what the end-to-end
#       suite's compose stack does (its nginx serves this client and proxies /api on one origin), and the empty
#       value there is load-bearing, not an oversight.
#
#   A hosted client with NO proxy needs the backend's full origin here. A relative path would resolve against the
#       front end's own host and 404. There is no such host today: the project runs locally.
VITE_API_BASE_URL=http://localhost:8080

# The Google Maps browser key for the address search.
#
# 🔴 NEVER COMMIT A REAL ONE. Vite inlines every VITE_* value into the shipped bundle, so a key here is a key in
# every build and on every clone — this repository carried a live one in a tracked file for months (register B2),
# and deleting the line did not revoke it. Put your own key in `.env.local`, which is ignored and never committed,
# and restrict it by referrer and API in the Google Cloud console.
#
# Without a key the address fields still accept and submit a typed address; they simply offer no suggestions.
VITE_GOOGLE_API_KEY=
